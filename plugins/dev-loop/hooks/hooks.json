{
  "modules": ["settings.tsx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/dl-bootstrap\" >&2; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/self-test.py\""},
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-guard.sh\""},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.py\""}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/approval.py\""},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-recall.py\""},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.py\""}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.sh\""}
        ]
      },
      {
        "matcher": "Bash|PowerShell|Agent|Task|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules-guard.py\""}
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brief-contract.py\""}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/hooks/push-guard.py\""}
        ]
      },
      {
        "hooks": [
          {"type": "command", "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT}/hooks/context-gate.py\""}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/post-edit-check.sh\""},
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-on-edit.sh\""},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/additive-tests.py\""}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-loop-trigger.sh\""}
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-recall.py\""}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/done-guard.sh\""},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.py\""}
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.py\""}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.py\""}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end-clean.sh\""},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-state.py\""}
        ]
      }
    ]
  }
}
