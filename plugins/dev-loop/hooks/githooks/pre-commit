#!/usr/bin/env sh
# Runs as `dl githook pre-commit`, for whoever commits, agent or person.
# Tests: tests/test_githook.py, tests/test_neutral_guards.py.
# 1. Refuses a commit on a protected branch: branches.integration, branches.release and
#    branches.protected from dev-loop.yaml. A config that cannot be read keeps main protected.
#    A detached HEAD (a rebase in progress) has no branch and is let through.
# 2. Reminds the committer that .claude/settings.json is shared by every agent and session; warns.
dl="$(dirname "$0")/../../bin/dl"
branch="$(git branch --show-current 2>/dev/null)"
if [ -n "$branch" ]; then
  protected="$(for key in integration release protected; do
    bash "$dl" config get "branches.$key" 2>/dev/null || echo main
  done)"
  if printf '%s\n' "$protected" | grep -qxF -- "$branch"; then
    echo "pre-commit: refusing to commit on protected branch '$branch'. Make a branch for the" \
      "change and commit there: git switch -c <change-branch>" >&2
    exit 1
  fi
fi
staged="$(git diff --cached --name-only)" || { echo "pre-commit: cannot list staged files" >&2; exit 1; }
if printf '%s\n' "$staged" | grep -qx '\.claude/settings\.json'; then
  echo "pre-commit: .claude/settings.json is staged. It is shared by every agent and session in this repo" \
    "(hooks, permissions, plugins); commit it only when that change is meant for all of them." >&2
fi
exit 0
